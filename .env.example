# Copy to .env (never commit .env). All values are optional.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=data/market_intel.db

# --- Optional LLM mode (default: off -> free deterministic fallback) ---
# Gemini via Google AI Studio's free tier: create a key at https://aistudio.google.com/apikey
# then set LLM_PROVIDER=gemini and GEMINI_API_KEY (or LLM_API_KEY). Never commit the key.
# Free-tier limits and data-use terms are per project and can change: see AI Studio's rate-limit page.
# LLM_PROVIDER: none | gemini | openai_compatible (any OpenAI-style endpoint via LLM_BASE_URL)
LLM_PROVIDER=none
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash       # pick a model that is free-tier eligible for your project
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # default for gemini
LLM_DAILY_CALL_BUDGET=50          # hard cap on LLM HTTP calls per UTC day (retries count)
LLM_MIN_INTERVAL_S=4              # minimum seconds between calls
LLM_RETRIES=2

# --- Optional tuning ---
# FEEDS=BBC / Business|https://feeds.bbci.co.uk/news/business/rss.xml,NYT / Business|https://rss.nytimes.com/services/xml/rss/nyt/Business.xml
MAX_ARTICLES_PER_RUN=60
MAX_ARTICLES_PER_FEED=25
HTTP_TIMEOUT_S=8
HTTP_RETRIES=2
CACHE_TTL_S=600
STALE_AFTER_HOURS=72
RATE_LIMIT_PER_MIN=30
GENERATE_RATE_LIMIT_PER_MIN=5

# --- Launcher (start.py) ---
MODE=gateway                 # gateway (default, one port) | both | api | dashboard
PORT=8000
# FEEDS_FILE=config/feeds.json   # topic-tagged feed list; FEEDS (below) overrides it
MAX_FEEDS_PER_RUN=10
# TRUST_PROXY=true             # only behind a proxy you trust (e.g. Render); PROXY_HOPS=1
